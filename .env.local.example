# Copy to .env.local and fill in from Supabase:
#   Project Settings -> API Keys -> "Publishable and secret API keys" tab
#
# Use the *publishable* key (sb_publishable_...), not a legacy anon JWT.
# It is safe in the browser: RLS is what protects the data, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Do NOT put the secret key (sb_secret_...) here. Nothing in this app needs it —
# every privileged operation runs inside a SECURITY DEFINER function in Postgres.
# A NEXT_PUBLIC_ prefix would also ship it straight to the browser.

# Optional locally, RECOMMENDED in production once you have a custom domain.
# Pins the origin OAuth returns to, so sign-in always lands on the canonical URL
# instead of whichever deployment URL happened to serve the request.
# Leave it UNSET on Vercel preview deployments, or every preview will redirect to
# production. No trailing slash.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
